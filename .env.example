APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo (Gmail SMTP, puerto 465 = SMTPS). Se usa para "restablecer contraseña" y demas notificaciones.
# MAIL_PASSWORD = App Password de Gmail (16 caracteres), NO la contraseña normal. Va vacio en el repo.
# Para inspeccionar el correo SIN enviarlo, usa MAIL_MAILER=log (se escribe en storage/logs/laravel.log).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=mailtecnoweb@gmail.com
MAIL_PASSWORD=nafrqvtvxdreaebf
MAIL_FROM_ADDRESS=mailtecnoweb@gmail.com
MAIL_FROM_NAME="Tienda D & D"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PagoFacil (pago por QR — requisito #10). Credenciales del curso; el cobro es simbolico.
PAGOFACIL_BASE_URL=
PAGOFACIL_TOKEN_SERVICE=
PAGOFACIL_TOKEN_SECRET=
# verify_ssl: true en produccion. false SOLO en local si cURL da "error 60" (Windows sin bundle CA).
PAGOFACIL_VERIFY_SSL=true
PAGOFACIL_AMOUNT=0.01
PAGOFACIL_CURRENCY=2
PAGOFACIL_DOCUMENT_TYPE=1
PAGOFACIL_PAYMENT_METHOD=
PAGOFACIL_CALLBACK_URL=https://tu-dominio.com/callback
PAGOFACIL_POLL_SECONDS=5
PAGOFACIL_QR_TIMEOUT_SECONDS=150
PAGOFACIL_PAID_STATUS=5
PAGOFACIL_VOID_STATUS=4
PAGOFACIL_USE_ENV_CLIENT=true
PAGOFACIL_CLIENT_NAME="Cliente Tienda D&D"
PAGOFACIL_CLIENT_DOCUMENT=0000000
PAGOFACIL_CLIENT_PHONE=70000000
PAGOFACIL_CLIENT_EMAIL=cliente@tiendadyd.com
PAGOFACIL_CLIENT_CODE=TIENDADYD
